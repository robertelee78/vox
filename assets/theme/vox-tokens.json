  "type": {
    "app.text":    { "family": "SF Pro",        "system": "body",       "weight": 400 },
    "app.mono":    { "family": "SF Mono",       "system": "monospaced", "weight": 400 },
    "app.eyebrow": { "family": "SF Mono",       "system": "monospaced", "weight": 600, "tracking": 0.12, "uppercase": true, "size": 11 },
    "app.heading": { "family": "Inter Display", "bundled": "InterDisplay-ExtraBold.otf", "weight": 800, "tracking": -0.02 }
  },
  "motion": {
    "tui.max_frames": 3,
    "tui.frame_ms": 16,
    "app.spring_response_ms": 200,
    "app.spring_damping": 1.0
