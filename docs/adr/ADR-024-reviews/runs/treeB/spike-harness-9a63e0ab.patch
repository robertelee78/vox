+// ---- timeline -------------------------------------------------------------------------------
+
+/// Sample (vox, competitor) byte counters every `step` for `dur`, print per-step Mbit/s.
+fn timeline(label: &str, dur: Duration, step: Duration, mut at: impl FnMut(Duration)) -> Vec<(f64, f64)> {
+    let start = Instant::now();
+    let mut out = Vec::new();
+    let (mut v0, mut c0) = (SINK_BYTES.load(Ordering::Relaxed), COMP_BYTES.load(Ordering::Relaxed));
+    let mut k = 1u32;
+    while start.elapsed() < dur {
+        at(start.elapsed());
+        sleep_until(start + step * k);
+        let (v, c) = (SINK_BYTES.load(Ordering::Relaxed), COMP_BYTES.load(Ordering::Relaxed));
+        let s = step.as_secs_f64();
+        let row = ((v - v0) as f64 * 8.0 / s / 1e6, (c - c0) as f64 * 8.0 / s / 1e6);
+        eprintln!(
+            "TL {label} t={:.1} vox {:.1} comp {:.1} Mbit/s late {} ms",
+            (step * k).as_secs_f64(),
+            row.0,
+            row.1,
+            LATENESS_US.swap(0, Ordering::Relaxed) / 1000
+        );
+        out.push(row);
+        (v0, c0) = (v, c);
+        k += 1;
+    }
+    out
+}
+
+fn mean(v: &[f64]) -> f64 {
+    v.iter().sum::<f64>() / v.len().max(1) as f64
+}
