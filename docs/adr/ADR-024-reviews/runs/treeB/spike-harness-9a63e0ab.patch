@@ -0,0 +1,594 @@
+//! SPIKE (ADR-024 M24.1/M24.2, never committed). Arms selected by SPIKE_ARM:
+//! lossy | congested | changing. Controller selected in the vox processes by VOX_SPIKE_CC etc.
+//! A competing stock-quinn-Cubic flow shares the emulator's forward bottleneck.
+
+#![cfg(unix)]
+
+#[path = "../../vox-core/tests/support/watchdog.rs"]
+mod watchdog;
+
+use std::io::{BufRead, BufReader, Read, Write};
+use std::net::{SocketAddr, TcpListener, TcpStream};
+use std::process::{Child, Command, Stdio};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::{Duration, Instant};
+
+const VOX: &str = env!("CARGO_BIN_EXE_vox");
+
+#[derive(Clone, Copy, Debug)]
+struct Link {
+    bits_per_sec: f64,
+    one_way: Duration,
+    loss: f64,
+    /// Forward queue limit in bytes.
+    queue: f64,
+}
+
+type Shared = Arc<Mutex<Option<Link>>>;
+
+static TAIL_DROPS: AtomicU64 = AtomicU64::new(0);
+static LOSS_DROPS: AtomicU64 = AtomicU64::new(0);
+static LATENESS_US: AtomicU64 = AtomicU64::new(0);
+static SINK_BYTES: AtomicU64 = AtomicU64::new(0);
+static COMP_BYTES: AtomicU64 = AtomicU64::new(0);
+
+struct Pacer {
+    next_free: Instant,
+}
+
+impl Pacer {
+    fn new() -> Self {
+        Self { next_free: Instant::now() }
+    }
+    fn release(&mut self, link: &Link, now: Instant, len: usize) -> Instant {
+        let serialise = Duration::from_secs_f64(len as f64 * 8.0 / link.bits_per_sec);
+        let start = self.next_free.max(now);
+        self.next_free = start + serialise;
+        self.next_free + link.one_way
+    }
+}
+
+fn sleep_until(t: Instant) {
+    let now = Instant::now();
+    if t > now {
+        std::thread::sleep(t - now);
+    }
+}
+
+fn next_rand(state: &mut u64) -> f64 {
+    *state ^= *state << 13;
+    *state ^= *state >> 7;
+    *state ^= *state << 17;
+    (*state >> 11) as f64 / (1u64 << 53) as f64
+}
+
+fn big_buffers(sock: &std::net::UdpSocket) {
+    let s = socket2::SockRef::from(sock);
+    let mut n = 64 << 20;
+    while n >= 1 << 20 && s.set_recv_buffer_size(n).is_err() {
+        n /= 2;
+    }
+    let mut n = 64 << 20;
+    while n >= 1 << 20 && s.set_send_buffer_size(n).is_err() {
+        n /= 2;
+    }
+}
+
+/// One direction: packets from `rx` (via `recv`) are paced by `pacer` (shared for the forward
+/// bottleneck) and delivered by `send`.
+fn direction(
+    recv: impl FnMut(&mut [u8]) -> Option<usize> + Send + 'static,
+    send: impl Fn(&[u8]) + Send + 'static,
+    link: Shared,
+    pacer: Arc<Mutex<Pacer>>,
+    limit_queue: bool,
+    seed: u64,
+) {
+    let (tx, queue) = mpsc::channel::<(Instant, Vec<u8>, bool)>();
+    let mut recv = recv;
+    std::thread::spawn(move || {
+        let mut buf = vec![0u8; 65536];
+        let mut rng = seed | 1;
+        while let Some(n) = recv(&mut buf) {
+            let now = Instant::now();
+            let l = *link.lock().unwrap();
+            let due = match l {
+                None => now,
+                Some(l) => {
+                    if l.loss > 0.0 && next_rand(&mut rng) < l.loss {
+                        LOSS_DROPS.fetch_add(1, Ordering::Relaxed);
+                        continue;
+                    }
+                    let mut p = pacer.lock().unwrap();
+                    let backlog = p.next_free.saturating_duration_since(now).as_secs_f64()
+                        * l.bits_per_sec
+                        / 8.0;
+                    if limit_queue && backlog > l.queue {
+                        TAIL_DROPS.fetch_add(1, Ordering::Relaxed);
+                        continue;
+                    }
+                    p.release(&l, now, n + 28)
+                }
+            };
+            if tx.send((due, buf[..n].to_vec(), l.is_some())).is_err() {
+                return;
+            }
+        }
+    });
+    std::thread::spawn(move || {
+        for (due, pkt, shaped) in queue {
+            sleep_until(due);
+            if shaped {
+                let late = Instant::now().saturating_duration_since(due).as_micros() as u64;
+                LATENESS_US.fetch_max(late, Ordering::Relaxed);
+            }
+            send(&pkt);
+        }
+    });
+}
+
+/// A UDP shaper in front of `upstream`; client->upstream goes through the shared `bottleneck`.
+fn udp_shaper(upstream: SocketAddr, link: Shared, bottleneck: Arc<Mutex<Pacer>>, seed: u64) -> SocketAddr {
+    let front = std::net::UdpSocket::bind("127.0.0.1:0").unwrap();
+    let back = std::net::UdpSocket::bind("127.0.0.1:0").unwrap();
+    big_buffers(&front);
+    big_buffers(&back);
+    back.connect(upstream).unwrap();
+    let addr = front.local_addr().unwrap();
+    let client: Arc<Mutex<Option<SocketAddr>>> = Arc::new(Mutex::new(None));
+    let (front_rx, back_tx) = (front.try_clone().unwrap(), back.try_clone().unwrap());
+    let learn = Arc::clone(&client);
+    direction(
+        move |buf| {
+            front_rx.recv_from(buf).ok().map(|(n, from)| {
+                *learn.lock().unwrap() = Some(from);
+                n
+            })
+        },
+        move |pkt| {
+            let _ = back_tx.send(pkt);
+        },
+        Arc::clone(&link),
+        bottleneck,
+        true,
+        seed,
+    );
+    let who = Arc::clone(&client);
+    direction(
+        move |buf| back.recv(buf).ok(),
+        move |pkt| {
+            if let Some(to) = *who.lock().unwrap() {
+                let _ = front.send_to(pkt, to);
+            }
+        },
+        link,
+        Arc::new(Mutex::new(Pacer::new())),
+        false,
+        seed ^ 0x2545_f491_4f6c_dd1d,
+    );
+    addr
+}
+
+struct Proc {
+    name: &'static str,
+    child: Child,
+    lines: Arc<Mutex<Vec<String>>>,
+}
+
+impl Drop for Proc {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+impl Proc {
+    fn spawn(name: &'static str, dir: &std::path::Path, args: &[&str], env: &[(&str, &str)]) -> Self {
+        let mut child = Command::new(VOX)
+            .args(args)
+            .envs(env.iter().copied())
+            .env("VOX_DATA_DIR", dir)
+            .env("VOX_CONFIG_DIR", dir.join("cfg"))
+            .env("VOX_IDENTITY_PASSPHRASE", "identity passphrase")
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap();
+        let lines = Arc::new(Mutex::new(Vec::new()));
+        for stream in [
+            child.stdout.take().map(|s| Box::new(s) as Box<dyn Read + Send>),
+            child.stderr.take().map(|s| Box::new(s) as Box<dyn Read + Send>),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            let sink = Arc::clone(&lines);
+            std::thread::spawn(move || {
+                for line in BufReader::new(stream).lines().map_while(Result::ok) {
+                    sink.lock().unwrap().push(line);
+                }
+            });
+        }
+        Self { name, child, lines }
+    }
+    fn said(&self) -> Vec<String> {
+        self.lines.lock().unwrap().clone()
+    }
+    fn expect_line(&self, what: &str, pred: impl Fn(&str) -> bool) -> String {
+        let deadline = Instant::now() + Duration::from_secs(120);
+        while Instant::now() < deadline {
+            if let Some(l) = self.said().into_iter().find(|l| pred(l)) {
+                return l;
+            }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        panic!("{}: never printed {what}:\n{}", self.name, self.said().join("\n"));
+    }
+}
+
+fn vox_once_env(dir: &std::path::Path, args: &[&str], env: &[(&str, &str)]) -> (bool, String, String) {
+    let out = Command::new(VOX)
+        .args(args)
+        .envs(env.iter().copied())
+        .env("VOX_DATA_DIR", dir)
+        .env("VOX_CONFIG_DIR", dir.join("cfg"))
+        .env("VOX_IDENTITY_PASSPHRASE", "identity passphrase")
+        .stdin(Stdio::null())
+        .output()
+        .unwrap();
+    (
+        out.status.success(),
+        String::from_utf8_lossy(&out.stdout).into_owned(),
+        String::from_utf8_lossy(&out.stderr).into_owned(),
+    )
+}
+
+fn after_label(line: &str, label: &str) -> String {
+    line.strip_prefix(label).unwrap().trim().to_owned()
+}
+
+fn room_pass_file(dir: &std::path::Path, pass: &str) -> String {
+    let at = dir.join("room-passphrase");
+    std::fs::write(&at, pass).unwrap();
+    at.to_str().unwrap().to_owned()
+}
+
+/// Sink: counts every byte into SINK_BYTES.
+fn sink() -> u16 {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = listener.local_addr().unwrap().port();
+    std::thread::spawn(move || {
+        for s in listener.incoming() {
+            let Ok(mut s) = s else { continue };
+            std::thread::spawn(move || {
+                let mut buf = vec![0u8; 256 * 1024];
+                while let Ok(n) = s.read(&mut buf) {
+                    if n == 0 {
+                        return;
+                    }
+                    SINK_BYTES.fetch_add(n as u64, Ordering::Relaxed);
+                }
+            });
+        }
+    });
+    port
+}
+
+/// Write to `to` until `stop`.
+fn pump(to: SocketAddr, stop: Arc<AtomicBool>) -> std::thread::JoinHandle<()> {
+    std::thread::spawn(move || {
+        let chunk = vec![0x5au8; 256 * 1024];
+        let mut s = TcpStream::connect(to).unwrap();
+        while !stop.load(Ordering::Relaxed) {
+            if s.write_all(&chunk).is_err() {
+                return;
+            }
+        }
+    })
+}
