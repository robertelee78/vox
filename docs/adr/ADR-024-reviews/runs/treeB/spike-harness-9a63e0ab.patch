@@ -0,0 +1,329 @@
+//! SPIKE (ADR-024 M24.1, never committed): env-selected controller with a per-event trace.
+
+use std::any::Any;
+use std::io::Write as _;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+use quinn::congestion::{BbrConfig, Controller, ControllerFactory, ControllerMetrics};
+use quinn_proto::RttEstimator;
+
+use super::VoxCubic;
+
+struct Params {
+    mode: String,
+    beta_rand: f64,
+    signal: String,
+    veno_pkts: f64,
+    veno_frac: f64,
+    delay_ms: f64,
+    delay_frac: f64,
+    cap: f64,
+    entry: f64,
+    rise_abs: f64,
+    trend_bytes: f64,
+    trace: Option<Mutex<std::fs::File>>,
+    epoch: Instant,
+}
+
+fn env_f(k: &str, d: f64) -> f64 {
+    std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(d)
+}
+
+fn p() -> &'static Params {
+    static P: OnceLock<Params> = OnceLock::new();
+    P.get_or_init(|| Params {
+        mode: std::env::var("VOX_SPIKE_CC").unwrap_or_else(|_| "cubic".into()),
+        beta_rand: env_f("VOX_SPIKE_BETA_RAND", 0.85),
+        signal: std::env::var("VOX_SPIKE_SIGNAL").unwrap_or_else(|_| "either".into()),
+        veno_pkts: env_f("VOX_SPIKE_VENO_PKTS", 3.0),
+        veno_frac: env_f("VOX_SPIKE_VENO_FRAC", 0.1),
+        delay_ms: env_f("VOX_SPIKE_DELAY_MS", 2.0),
+        delay_frac: env_f("VOX_SPIKE_DELAY_FRAC", 0.25),
+        cap: env_f("VOX_SPIKE_CAP", 1.0),
+        entry: env_f("VOX_SPIKE_ENTRY", -1.0),
+        rise_abs: env_f("VOX_SPIKE_RISE_ABS", 0.005),
+        trend_bytes: env_f("VOX_SPIKE_TREND_BYTES", 33554432.0),
+        trace: std::env::var("VOX_SPIKE_TRACE").ok().map(|f| {
+            Mutex::new(
+                std::fs::OpenOptions::new()
+                    .create(true)
+                    .append(true)
+                    .open(f)
+                    .expect("spike trace"),
+            )
+        }),
+        epoch: Instant::now(),
+    })
+}
+
+fn trace(line: std::fmt::Arguments<'_>) {
+    if let Some(f) = &p().trace {
+        let _ = writeln!(f.lock().unwrap(), "{line}");
+    }
+}
+
+pub(crate) fn bbr(_now: Instant, _mtu: u16) -> Option<Box<dyn Controller>> {
+    None
+}
+
+pub(crate) fn inner(now: Instant, mtu: u16) -> Box<dyn Controller> {
+    static ID: AtomicU64 = AtomicU64::new(1);
+    let inner = match p().mode.as_str() {
+        "bbr" => Inner::Other(std::sync::Arc::new(BbrConfig::default()).build(now, mtu)),
+        _ => Inner::Cubic(VoxCubic::new(now, mtu)),
+    };
+    Box::new(Spike {
+        inner,
+        id: ID.fetch_add(1, Ordering::Relaxed),
+        mtu: u64::from(mtu),
+        srtt: Duration::ZERO,
+        min: Duration::ZERO,
+        last_pn: 0,
+        round_end: None,
+        round_min: None,
+        last_round_min: None,
+        tick: None,
+        acked: 0,
+        rand: 0,
+        cong: 0,
+        lost: 0,
+        mins: std::collections::VecDeque::new(),
+        rsent: 0,
+        rlost: 0,
+        ring: std::collections::VecDeque::new(),
+    })
+}
+
+enum Inner {
+    Cubic(VoxCubic),
+    Other(Box<dyn Controller>),
+}
+
+impl Inner {
+    fn c(&self) -> &dyn Controller {
+        match self {
+            Inner::Cubic(c) => c,
+            Inner::Other(o) => o.as_ref(),
+        }
+    }
+    fn m(&mut self) -> &mut dyn Controller {
+        match self {
+            Inner::Cubic(c) => c,
+            Inner::Other(o) => o.as_mut(),
+        }
+    }
+}
+
+struct Spike {
+    inner: Inner,
+    id: u64,
+    mtu: u64,
+    srtt: Duration,
+    min: Duration,
+    last_pn: u64,
+    round_end: Option<u64>,
+    round_min: Option<Duration>,
+    last_round_min: Option<Duration>,
+    tick: Option<Instant>,
+    acked: u64,
+    rand: u64,
+    cong: u64,
+    lost: u64,
+    mins: std::collections::VecDeque<(Instant, Duration)>,
+    rsent: u64,
+    rlost: u64,
+    ring: std::collections::VecDeque<(u64, u64)>,
+}
+
+fn us(d: Option<Duration>) -> i64 {
+    d.map_or(-1, |d| d.as_micros() as i64)
+}
+
+impl Spike {
+    fn t(&self, now: Instant) -> u128 {
+        now.saturating_duration_since(p().epoch).as_millis()
+    }
+    fn veno(&self) -> f64 {
+        if self.srtt.is_zero() || self.min >= self.srtt {
+            return 0.0;
+        }
+        self.inner.c().window() as f64 * (1.0 - self.min.as_secs_f64() / self.srtt.as_secs_f64())
+    }
+    fn queue_delay(&self) -> Option<Duration> {
+        self.last_round_min.map(|m| m.saturating_sub(self.min))
+    }
+}
+
+impl Clone for Spike {
+    fn clone(&self) -> Self {
+        Self {
+            inner: match &self.inner {
+                Inner::Cubic(c) => Inner::Cubic(c.clone()),
+                Inner::Other(o) => Inner::Other(o.clone_box()),
+            },
+            mins: self.mins.clone(),
+            ring: self.ring.clone(),
+            ..*self
+        }
+    }
+}
+
+impl Controller for Spike {
+    fn on_sent(&mut self, now: Instant, bytes: u64, last_packet_number: u64) {
+        self.last_pn = last_packet_number;
+        self.rsent += bytes;
+        if self.round_end.is_none() {
+            self.round_end = Some(last_packet_number);
+        }
+        self.inner.m().on_sent(now, bytes, last_packet_number);
+    }
+
+    fn on_ack(&mut self, now: Instant, sent: Instant, bytes: u64, app_limited: bool, rtt: &RttEstimator) {
+        self.srtt = rtt.get();
+        let s = now.saturating_duration_since(sent);
+        // Windowed path minimum over the last 10 s of samples (quinn's min is lifetime and read 0).
+        while self.mins.back().is_some_and(|(_, m)| *m >= s) {
+            self.mins.pop_back();
+        }
+        self.mins.push_back((now, s));
+        while self.mins.front().is_some_and(|(t, _)| now.saturating_duration_since(*t) > Duration::from_secs(10)) {
+            self.mins.pop_front();
+        }
+        self.min = self.mins.front().map_or(s, |(_, m)| *m);
+        let _ = rtt.min();
+        self.round_min = Some(self.round_min.map_or(s, |m| m.min(s)));
+        self.acked += bytes;
+        let tick = *self.tick.get_or_insert(now);
+        if now.saturating_duration_since(tick) >= Duration::from_millis(100) {
+            trace(format_args!(
+                "S {} {} cwnd {} srtt {} min {} lrm {} acked {} rand {} cong {} lost {} applim {}",
+                self.t(now),
+                self.id,
+                self.inner.c().window(),
+                self.srtt.as_micros(),
+                self.min.as_micros(),
+                us(self.last_round_min),
+                self.acked,
+                self.rand,
+                self.cong,
+                self.lost,
+                app_limited as u8
+            ));
+            self.tick = Some(now);
+            self.acked = 0;
+            self.rand = 0;
+            self.cong = 0;
+            self.lost = 0;
+        }
+        self.inner.m().on_ack(now, sent, bytes, app_limited, rtt);
+    }
+
+    fn on_end_acks(&mut self, now: Instant, in_flight: u64, app_limited: bool, largest: Option<u64>) {
+        if let (Some(a), Some(e)) = (largest, self.round_end) {
+            if a >= e {
+                self.last_round_min = self.round_min.or(self.last_round_min);
+                self.round_min = None;
+                self.round_end = Some(self.last_pn);
+                self.ring.push_back((self.rsent, self.rlost));
+                while self.ring.len() > 4096 {
+                    self.ring.pop_front();
+                }
+                self.rsent = 0;
+                self.rlost = 0;
+            }
+        }
+        self.inner.m().on_end_acks(now, in_flight, app_limited, largest);
+    }
+
+    fn on_congestion_event(&mut self, now: Instant, sent: Instant, persistent: bool, lost_bytes: u64) {
+        let pr = p();
+        self.lost += 1;
+        self.rlost += lost_bytes;
+        let (ts, tl) = self.ring.iter().rev().take(8).fold((self.rsent, self.rlost), |(a, b), &(s, l)| (a + s, b + l));
+        let share = if ts == 0 { 0.0 } else { tl as f64 / ts as f64 };
+        let (mut ls, mut ll) = (self.rsent, self.rlost);
+        for &(s, l) in self.ring.iter().rev() {
+            if ls as f64 >= pr.trend_bytes {
+                break;
+            }
+            ls += s;
+            ll += l;
+        }
+        let long_share = if ls as f64 >= pr.trend_bytes { ll as f64 / ls as f64 } else { 0.0 };
+        let veno = self.veno();
+        let cwnd = self.inner.c().window() as f64;
+        let veno_q = veno >= (pr.veno_pkts * self.mtu as f64).max(pr.veno_frac * cwnd);
+        let qd = self.queue_delay();
+        let delay_thr = Duration::from_secs_f64((pr.delay_ms / 1000.0).max(pr.delay_frac * self.min.as_secs_f64()));
+        let delay_q = qd.is_some_and(|d| d >= delay_thr);
+        let queued = match pr.signal.as_str() {
+            "veno" => veno_q,
+            "round" => delay_q,
+            "both" => veno_q && delay_q,
+            _ => veno_q || delay_q,
+        };
+        let risen = pr.entry >= 0.0 && long_share > (1.5 * pr.entry).max(pr.entry + pr.rise_abs);
+        let congestion = persistent || lost_bytes == 0 || queued || share > pr.cap || risen;
+        let (decision, acted) = match &mut self.inner {
+            Inner::Cubic(c) if pr.mode == "tier2" && !congestion => {
+                let acted = if pr.beta_rand >= 1.0 { false } else { c.reduce(now, sent, false, pr.beta_rand) };
+                ("rand", acted)
+            }
+            Inner::Cubic(c) => ("cong", c.reduce(now, sent, persistent, 0.7)),
+            Inner::Other(o) => {
+                o.on_congestion_event(now, sent, persistent, lost_bytes);
+                (if queued { "cong" } else { "rand" }, true)
+            }
+        };
+        if decision == "rand" {
+            self.rand += 1;
+        } else {
+            self.cong += 1;
+        }
+        trace(format_args!(
+            "L {} {} share {:.4} cwnd {} srtt {} min {} lrm {} rm {} veno {:.0} venoq {} qd {} delayq {} {} acted {} lost {}",
+            self.t(now),
+            self.id,
+            share,
+            cwnd as u64,
+            self.srtt.as_micros(),
+            self.min.as_micros(),
+            us(self.last_round_min),
+            us(self.round_min),
+            veno,
+            veno_q as u8,
+            us(qd),
+            delay_q as u8,
+            decision,
+            acted as u8,
+            lost_bytes
+        ));
+    }
+
+    fn on_mtu_update(&mut self, new_mtu: u16) {
+        self.mtu = u64::from(new_mtu);
+        self.inner.m().on_mtu_update(new_mtu);
+    }
+
+    fn window(&self) -> u64 {
+        self.inner.c().window()
+    }
+
+    fn metrics(&self) -> ControllerMetrics {
+        self.inner.c().metrics()
+    }
+
+    fn clone_box(&self) -> Box<dyn Controller> {
+        Box::new(self.clone())
+    }
+
+    fn initial_window(&self) -> u64 {
+        self.inner.c().initial_window()
+    }
+
+    fn into_any(self: Box<Self>) -> Box<dyn Any> {
+        self
+    }
+}
